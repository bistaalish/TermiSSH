{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TermiSSH",
  "version": "1.0.0",
  "identifier": "com.termissh.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TermiSSH - Modern Linux SSH Client",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modern, secure SSH client and terminal workspace for Linux",
    "longDescription": "TermiSSH is a high-performance SSH client featuring interactive terminals, split panes, SFTP dual-pane manager, port forwarding, encrypted secret vault, and snippets."
  }
}
